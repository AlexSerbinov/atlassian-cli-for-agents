DUR = re.compile(r"(?:(\d+)w)?\s*(?:(\d+)d)?\s*(?:(\d+)h)?\s*(?:(\d+)m)?$", re.I)


def parse_duration(s):
    """'2h30m' / '1d 4h' / '90m' -> seconds. Jira workday = 8h, week = 5d."""
    s = s.strip()
    if s.isdigit():
        return int(s) * 60
    m = DUR.match(s)
    if not m or not any(m.groups()):
        sys.exit(f"atl: cannot parse duration {s!r} (use forms like 2h30m, 1d, 45m)")
    w, d, h, mi = (int(x) if x else 0 for x in m.groups())
    return ((w * 5 + d) * 8 * 3600) + h * 3600 + mi * 60


def fmt_duration(sec):
    h, rem = divmod(int(sec), 3600)
    m = rem // 60
    if h and m:
        return f"{h}h{m}m"
    return f"{h}h" if h else f"{m}m"


def local_offset():
    return datetime.now(timezone.utc).astimezone().strftime("%z")


def jira_datetime(day=None, time="12:00:00"):
    """Jira wants 2026-06-24T12:40:00.000+0200 — naive ISO is rejected."""
    day = day or datetime.now().strftime("%Y-%m-%d")
    return f"{day}T{time}.000{local_offset()}"


def out_json(obj):
    json.dump(obj, sys.stdout, ensure_ascii=False, indent=2)
    print()


def resolve_account(creds, who):
    """Display name / email -> accountId. Jira silently ignores a bad one."""
    if not who:
        return None
    if who in ("me", "self", "currentUser"):
        return api(creds, "/rest/api/3/myself")["accountId"]
    if re.fullmatch(r"[0-9a-f]{6,}:[0-9a-f-]{36}", who) or who.startswith("qm:"):
        return who
    hits = api(creds, "/rest/api/3/user/search", {"query": who, "maxResults": 10})
    if not hits:
        sys.exit(f"atl: no Jira user matches {who!r}")
    exact = [u for u in hits
             if who.lower() in (str(u.get("displayName", "")).lower(),
                                str(u.get("emailAddress", "")).lower())]
    pick = (exact or hits)[0]
    if len(exact or hits) > 1 and not exact:
        names = ", ".join(f"{u.get('displayName')} <{u.get('emailAddress')}>" for u in hits[:5])
        sys.exit(f"atl: {who!r} is ambiguous: {names}")
    return pick["accountId"]


