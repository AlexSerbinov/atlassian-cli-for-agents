BRIEF_FIELDS = "summary,status,assignee,issuetype,priority,parent,duedate,timetracking"


TOKEN_URL = "https://id.atlassian.com/manage-profile/security/api-tokens"


def _prompt(fn, *args):
    """Run one interactive prompt. No stdin is a clean error, not a traceback.

    Agent harnesses and CI run commands without a terminal; the first prompt
    then hits EOF. Say what to do instead of dumping a stack trace.
    """
    try:
        return fn(*args)
    except EOFError:
        sys.exit(
            "atl: init needs an interactive terminal — stdin reached EOF.\n"
            "  Run `atl init` from a shell, or write " + ATL_CONFIG + " by hand:\n"
            '  {"url": "https://you.atlassian.net", "user": "you@example.com",\n'
            '   "token_command": "secret-tool lookup service atl account you@example.com"}')


def _keychain_recipe(user):
    """A `token_command` for the OS keychain, if this platform has one."""
    if sys.platform == "darwin":
        return (f"security find-generic-password -s atl -a {user} -w",
                f"security add-generic-password -U -s atl -a {user} -w 'YOUR_TOKEN'",
                "macOS Keychain")
    if sys.platform.startswith("linux"):
        return (f"secret-tool lookup service atl account {user}",
                f"secret-tool store --label='atl' service atl account {user}",
                "GNOME Keyring / libsecret")
    return None


def cmd_init(_unused, a):
    """Write ~/.atl.json interactively. The token is never echoed."""
    import getpass

    existing = {}
    if os.path.exists(ATL_CONFIG):
        try:
            with open(ATL_CONFIG) as f:
                existing = json.load(f)
        except ValueError:
            pass
        if not a.force:
            sys.exit(f"atl: {ATL_CONFIG} already exists; pass --force to overwrite")

    def ask(prompt, default=""):
        shown = f" [{default}]" if default else ""
        return _prompt(input, f"{prompt}{shown}: ").strip() or default

    print("atl setup\n")
    print("1. Open " + TOKEN_URL)
    print("2. Create API token  ->  name it 'atl', pick an expiry")
    print("3. Copy it now — Atlassian will not show it again\n")
    print("   Use a CLASSIC token (the plain 'Create API token' button).")
    print("   Scoped tokens work too but need a cloud id; see --scoped below.\n")

    url = ask("Site URL (https://you.atlassian.net)", existing.get("url", ""))
    user = ask("Account email", existing.get("user", ""))
    if not (url and user):
        sys.exit("atl: site URL and email are both required")
    url = url.rstrip("/")

    cfg = {"url": url, "user": user}
    wiki = ask("Confluence base URL", (existing.get("site_wiki") or url + "/wiki"))
    if wiki.rstrip("/") != url + "/wiki":
        cfg["confluence_url"] = wiki.rstrip("/")

    if a.scoped:
        cid = discover_cloud_id(url)
        if not cid:
            sys.exit(f"atl: could not read the cloud id from {url}/_edge/tenant_info; "
                     "pass it manually as \"cloud_id\" in " + ATL_CONFIG)
        cfg["cloud_id"] = cid
        print(f"\ncloud id: {cid}  (calls will go through api.atlassian.com)")

    # --- where the token lives -------------------------------------------
    kc = _keychain_recipe(user)
    print("\nWhere should the token be stored?")
    print("  1) a command (password manager: 1Password, pass, gopass, Vault) — most secure")
    if kc:
        print(f"  2) {kc[2]}")
    print(f"  {'3' if kc else '2'}) {ATL_CONFIG}, mode 600 — simplest")
    choice = ask("Choice", "3" if kc else "2")

    if choice == "1":
        cmd = ask("Command that prints the token on stdout")
        if not cmd:
            sys.exit("atl: no command given")
        cfg["token_command"] = cmd
    elif kc and choice == "2":
        cfg["token_command"] = kc[0]
        print(f"\nStore the token once with:\n  {kc[1]}")
        if sys.platform == "darwin":
            print("  (or add it by hand in Keychain Access, service 'atl')")
    else:
        token = _prompt(getpass.getpass, "API token (input hidden): ").strip()
        if not token:
            sys.exit("atl: no token given")
        cfg["token"] = token

    tmp = ATL_CONFIG + ".tmp"
    with open(tmp, "w") as f:
        json.dump(cfg, f, indent=2)
    os.chmod(tmp, 0o600)
    os.replace(tmp, ATL_CONFIG)
    print(f"\nwrote {ATL_CONFIG} (mode 600)")

    if "token" not in cfg and cfg.get("token_command"):
        print("Once the token is in place, check it with:  atl me")
        return
    try:
        who = api(load_creds(), "/rest/api/3/myself")
        print(f"authenticated as {who.get('displayName')} <{who.get('emailAddress')}>")
    except ApiError as e:
        print(f"warning: config written, but the check call failed — HTTP {e.status}")
        if e.status == 401:
            print("  401 usually means the token was copied incomplete, or it expired.")


