HOME = os.path.expanduser("~")
ATL_CONFIG = os.path.join(HOME, ".atl.json")
TOKEN_FILE = os.path.join(HOME, ".jira-api-token")
CLAUDE_CONFIG = os.path.join(HOME, ".claude.json")

# Jira's Sprint field is a custom field whose id differs per site. It is resolved
# once per call and cached in ~/.atl.json so the lookup does not repeat.
SPRINT_FIELD_DEFAULT = "customfield_10020"


