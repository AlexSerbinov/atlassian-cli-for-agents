          f"{sp.get('startDate','')[:10]} … {sp.get('endDate','')[:10]}")


def cmd_sprint_add(creds, a):
    """Move work items into a sprint. `--board N` resolves the active sprint."""
    sprint = a.sprint
    if sprint in ("current", "active"):
        if not a.board:
            sys.exit("atl: --board is required with sprint 'current'")
        sprint = _active_sprint(creds, a.board)["id"]
    keys = list(a.keys)
    # the Agile API caps a single call at 50 issues
    for chunk in [keys[i:i + 50] for i in range(0, len(keys), 50)]:
        api(creds, f"/rest/agile/1.0/sprint/{sprint}/issue", method="POST",
            body={"issues": chunk})
    print(f"{len(keys)} issue(s) -> sprint {sprint}: {', '.join(keys)}")


