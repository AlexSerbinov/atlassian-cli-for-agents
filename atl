    doc = json.loads(raw) if isinstance(raw, str) else raw
    return adf_to_md(doc)


def cmd_conf_diff(creds, a):
    """Unified diff between two versions, rendered on the Markdown form."""
    import difflib
    if not a.to:
        cur = api(creds, f"/api/v2/pages/{a.id}", base=creds["confluence_url"])
        a.to = cur["version"]["number"]
    a.to = int(a.to)
    a.from_ = int(a.from_) if a.from_ else max(1, a.to - 1)

    old = _page_version_md(creds, a.id, a.from_).splitlines()
    new = _page_version_md(creds, a.id, a.to).splitlines()
    diff = list(difflib.unified_diff(old, new,
                                     fromfile=f"v{a.from_}", tofile=f"v{a.to}",
                                     lineterm="", n=a.context))
    if not diff:
        print(f"v{a.from_} and v{a.to} are identical")
        return
    print("\n".join(diff))


