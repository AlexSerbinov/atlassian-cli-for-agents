        if not os.path.isfile(path):
            sys.exit(f"atl: no such file: {path}")
        res = upload(creds, f"/rest/api/3/issue/{a.key}/attachments", path)
        for at in res if isinstance(res, list) else [res]:
            print(f"{a.key} + {at['filename']}  (id {at['id']}, "
                  f"{at.get('size', 0)/1024:.0f} KB)")


