def _active_sprint(creds, board):
    d = api(creds, f"/rest/agile/1.0/board/{board}/sprint",
            {"state": "active", "maxResults": 50})
    vals = d.get("values", [])
    if not vals:
        sys.exit(f"atl: board {board} has no active sprint")
    return vals[0]


