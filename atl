def cmd_conf_put(creds, a):
    cur = api(creds, f"/api/v2/pages/{a.id}", {"body-format": "storage"},
              base=creds["confluence_url"])
    md = a.body if a.body and a.body.startswith("@") else \
        ("@" + a.body if a.body else None)
    doc = body_adf(creds, md, ("confluence", str(a.id))) if md \
        else resolve_media(creds, md_to_adf(sys.stdin.read()),
                           ("confluence", str(a.id)))
    title = a.title or cur["title"]
    body = {
        "id": str(a.id),
        "status": "current",
        "title": title,
        "version": {"number": cur["version"]["number"] + 1,
                    "message": a.message or "updated via atl"},
        "body": {"representation": "atlas_doc_format", "value": json.dumps(doc)},
    }
    res = api(creds, f"/api/v2/pages/{a.id}", method="PUT", body=body,
              base=creds["confluence_url"])
    print(f"page {res['id']} -> v{res['version']['number']}  {res['title']}")


