def main():
    argv = sys.argv[1:]
    a = build_parser().parse_args(argv)
    if not getattr(a, "fn", None):
        sys.exit("atl: incomplete command; try --help")
    # argparse lets the innermost --json (default None) overwrite an outer one.
    a.json = "--json" in argv
    try:
        a.fn(None if a.fn is cmd_init else load_creds(), a)
    except ApiError as e:
        body = e.body
        try:
            j = json.loads(body)
            msgs = list(j.get("errorMessages") or [])
            errs = j.get("errors")
            if isinstance(errs, dict):
                msgs += [f"{k}: {v}" for k, v in errs.items()]
            elif isinstance(errs, list):
                # Confluence shape: [{"status":404,"title":"Not Found","detail":null}]
                msgs += [" ".join(str(e.get(k)) for k in ("title", "detail")
                                  if e.get(k)) if isinstance(e, dict) else str(e)
                         for e in errs]
            if j.get("message"):
                msgs.append(j["message"])
            body = "; ".join(msgs) or body
        except ValueError:
            pass
        sys.exit(f"atl: HTTP {e.status} — {body}")
    except BrokenPipeError:
        pass


if __name__ == "__main__":
    main()
