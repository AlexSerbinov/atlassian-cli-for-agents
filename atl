    return c["id"], when, who


def cmd_conf_comments(creds, a):
    """Footer comments plus, unless --footer-only, the inline ones."""
    kinds = ["footer-comments"] if a.footer_only else ["footer-comments", "inline-comments"]
    rows = []
    for kind in kinds:
        d = api(creds, f"/api/v2/pages/{a.id}/{kind}",
                {"body-format": "atlas_doc_format", "limit": a.limit},
                base=creds["confluence_url"])
        for c in d.get("results", []):
            c["_kind"] = kind.split("-")[0]
            c["_depth"] = 0
            rows.append(c)
            # v2 returns only top-level comments; replies live under /children
            rows.extend(_conf_replies(creds, kind, c["id"], 1))
    if a.json:
        return out_json(rows)

    names = _account_names(creds, {(c.get("version") or {}).get("authorId") for c in rows})
    for c in rows:
        cid, when, who = _conf_comment_line(c)
        author = names.get((c.get("version") or {}).get("authorId"), who or "?")
        body = c.get("body", {}).get("atlas_doc_format", {}).get("value")
        doc = json.loads(body) if isinstance(body, str) else body
        pad = "    " * c.get("_depth", 0)
        arrow = "↳ " if c.get("_depth") else ""
        print(f"{pad}{arrow}[{cid}] {c['_kind']:<6} {when}  {author}")
        text = adf_to_md(doc).strip().replace("\n", "\n" + pad + "   ")
        print(f"{pad}   {text}")
        print()
    print(f"{len(rows)} comment(s)")


def _conf_replies(creds, kind, comment_id, depth, limit=50):
    """Replies to one comment, depth-first. Threads are usually one level deep."""
    try:
        d = api(creds, f"/api/v2/{kind}/{comment_id}/children",
                {"body-format": "atlas_doc_format", "limit": limit},
                base=creds["confluence_url"])
    except ApiError:
        return []
    out = []
    for c in d.get("results", []):
        c["_kind"] = kind.split("-")[0]
        c["_depth"] = depth
        out.append(c)
        if depth < 5:
            out.extend(_conf_replies(creds, kind, c["id"], depth + 1, limit))
    return out


def _account_names(creds, account_ids):
    """accountId -> display name. Confluence v2 only returns the raw ids."""
    ids = [i for i in account_ids if i]
    if not ids:
        return {}

    def one(acc):
        try:
            u = api(creds, "/rest/api/3/user", {"accountId": acc})
            return acc, u.get("displayName", acc)
        except ApiError:
            return acc, acc

    with ThreadPoolExecutor(max_workers=8) as pool:
        return dict(pool.map(one, ids))


