def cmd_download(creds, a):
    i = api(creds, f"/rest/api/3/issue/{a.key}", {"fields": "attachment"})
    atts = i["fields"].get("attachment", []) or []
    if a.name:
        atts = [x for x in atts if a.name.lower() in x["filename"].lower()]
    os.makedirs(a.dest, exist_ok=True)
    for at in atts:
        blob = api(creds, urllib.parse.urlparse(at["content"]).path, raw=True)
        dst = os.path.join(a.dest, at["filename"])
        with open(dst, "wb") as f:
            f.write(blob)
        print(f"{dst}  ({len(blob)/1024:.0f} KB)")


