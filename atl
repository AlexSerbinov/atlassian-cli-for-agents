def _worklogs(creds, key):
    out, start_at = [], 0
    while True:
        d = api(creds, f"/rest/api/3/issue/{key}/worklog",
                {"startAt": start_at, "maxResults": 100})
        out.extend(d.get("worklogs", []))
        start_at += d.get("maxResults", 0) or 100
        if start_at >= d.get("total", 0):
            return out


def cmd_worklog_list(creds, a):
    logs = _worklogs(creds, a.key)
    if a.mine:
        acc = api(creds, "/rest/api/3/myself")["accountId"]
        logs = [w for w in logs if (w.get("author") or {}).get("accountId") == acc]
    if a.json:
        return out_json(logs)
    total = 0
    for w in sorted(logs, key=lambda w: w.get("started", "")):
        total += w["timeSpentSeconds"]
        who = (w.get("author") or {}).get("displayName", "?")
        print(f"{w['id']:<10} {w['started'][:10]}  {w['timeSpent']:>7}  "
              f"{who:<20} {flat(w.get('comment'))[:60]}")
    print(f"\n{len(logs)} worklog(s), {fmt_duration(total)} total")


