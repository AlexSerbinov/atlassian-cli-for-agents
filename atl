class ApiError(Exception):
    def __init__(self, status, body, url):
        self.status, self.body, self.url = status, body, url
        super().__init__(f"HTTP {status} on {url}\n{body}")


def _auth_header(creds):
    raw = f"{creds['user']}:{creds['token']}".encode()
    return "Basic " + base64.b64encode(raw).decode()


def api(creds, path, params=None, method="GET", body=None, base=None, raw=False):
    """One JSON call. `path` is absolute-from-host, e.g. /rest/api/3/myself."""
    host = base or creds["url"]
    url = host + path
    if params:
        url += "?" + urllib.parse.urlencode(params, doseq=True)

    data = None
    headers = {"Authorization": _auth_header(creds), "Accept": "application/json"}
    if body is not None:
        data = json.dumps(body).encode()
        headers["Content-Type"] = "application/json"

    req = urllib.request.Request(url, data=data, headers=headers, method=method)
    try:
        with urllib.request.urlopen(req, timeout=90) as r:
            payload = r.read()
            if raw:
                return payload
            if not payload:
                return {}
            return json.loads(payload)
    except urllib.error.HTTPError as e:
        raise ApiError(e.code, e.read().decode("utf-8", "replace")[:2000], url) from None


def upload(creds, path, filepath, base=None, field="file", extra_headers=None):
    """multipart/form-data POST — attachments."""
    host = base or creds["url"]
    url = host + path
    boundary = "----atl" + uuid.uuid4().hex
    name = os.path.basename(filepath)
    ctype = mimetypes.guess_type(name)[0] or "application/octet-stream"

    with open(filepath, "rb") as f:
        content = f.read()

    body = b"".join([
        f"--{boundary}\r\n".encode(),
        f'Content-Disposition: form-data; name="{field}"; filename="{name}"\r\n'.encode(),
        f"Content-Type: {ctype}\r\n\r\n".encode(),
        content,
        f"\r\n--{boundary}--\r\n".encode(),
    ])

    headers = {
        "Authorization": _auth_header(creds),
        "Accept": "application/json",
        "X-Atlassian-Token": "no-check",
        "Content-Type": f"multipart/form-data; boundary={boundary}",
    }
    headers.update(extra_headers or {})

    req = urllib.request.Request(url, data=body, headers=headers, method="POST")
    try:
        with urllib.request.urlopen(req, timeout=300) as r:
            payload = r.read()
            return json.loads(payload) if payload else {}
    except urllib.error.HTTPError as e:
        raise ApiError(e.code, e.read().decode("utf-8", "replace")[:2000], url) from None


# --------------------------------------------------------------------------
# ADF  <->  Markdown
# --------------------------------------------------------------------------
# Jira REST v3 and Confluence Cloud v2 both take ADF. mcp-atlassian never
# learned to build it, which is why "transition with a comment" failed there.

_INLINE = re.compile(
    r"(?P<code>`[^`]+`)"
    r"|(?P<link>\[[^\]]+\]\([^)]+\))"
    r"|(?P<bold>\*\*[^*]+\*\*)"
    r"|(?P<italic>(?<![*\w])\*[^*\n]+\*(?![*\w]))"
)


def _inline_adf(text):
    """Markdown inline spans -> a list of ADF text nodes."""
    nodes, pos = [], 0

    def push(s, marks=None):
        if not s:
            return
        node = {"type": "text", "text": s}
        if marks:
            node["marks"] = marks
        nodes.append(node)

    for m in _INLINE.finditer(text):
        push(text[pos:m.start()])
        kind = m.lastgroup
        raw = m.group()
        if kind == "code":
            push(raw[1:-1], [{"type": "code"}])
        elif kind == "bold":
            push(raw[2:-2], [{"type": "strong"}])
        elif kind == "italic":
            push(raw[1:-1], [{"type": "em"}])
        elif kind == "link":
            label, href = re.match(r"\[([^\]]+)\]\(([^)]+)\)", raw).groups()
            push(label, [{"type": "link", "attrs": {"href": href}}])
        pos = m.end()
    push(text[pos:])
    return nodes or [{"type": "text", "text": " "}]


def md_to_adf(text):
    """A pragmatic Markdown subset -> ADF doc.

    Handles: headings, fenced code, bullet/ordered lists, blockquotes,
    horizontal rules, paragraphs, and the inline marks above. Anything else
    degrades to a plain paragraph rather than failing.
    """
    if not text:
        text = " "
    lines = text.replace("\r\n", "\n").split("\n")
    content, i = [], 0

    def para(buf):
        if buf:
            content.append({"type": "paragraph", "content": _inline_adf(" ".join(buf))})

    buf = []
    while i < len(lines):
        line = lines[i]
        stripped = line.strip()

        if stripped.startswith("```"):
            para(buf); buf = []
            lang = stripped[3:].strip() or None
            i += 1
            code = []
            while i < len(lines) and not lines[i].strip().startswith("```"):
                code.append(lines[i])
                i += 1
            i += 1
            node = {"type": "codeBlock",
                    "content": [{"type": "text", "text": "\n".join(code) or " "}]}
            if lang:
                node["attrs"] = {"language": lang}
            content.append(node)
            continue

        h = re.match(r"^(#{1,6})\s+(.*)$", stripped)
        if h:
            para(buf); buf = []
            content.append({
                "type": "heading",
                "attrs": {"level": len(h.group(1))},
                "content": _inline_adf(h.group(2)),
            })
            i += 1
            continue

        if re.match(r"^(-{3,}|\*{3,}|_{3,})$", stripped):
            para(buf); buf = []
            content.append({"type": "rule"})
            i += 1
            continue

        # a line that is nothing but images becomes block-level media. Inline
        # images inside a sentence stay links — ADF has no inline image that
        # Jira will render, and a silent downgrade beats a broken document.
        if stripped.startswith("!["):
            imgs = re.findall(r"!\[([^\]]*)\]\(([^)\s]+)(?:\s+\"([^\"]*)\")?\)", stripped)
            if imgs and re.fullmatch(r"(?:!\[[^\]]*\]\([^)]+\)\s*)+", stripped):
                para(buf); buf = []
                for alt, src, _title in imgs:
                    content.append({"type": IMAGE_PLACEHOLDER,
                                    "attrs": {"src": src, "alt": alt}})
                i += 1
                continue

        # table: a header row followed by a |---|---| separator
        if (stripped.startswith("|") and i + 1 < len(lines)
                and re.fullmatch(r"\|[\s:|-]+\|", lines[i + 1].strip() or "|")):
            para(buf); buf = []
            rows = []
            while i < len(lines) and lines[i].strip().startswith("|"):
                cells = [c.strip() for c in lines[i].strip().strip("|").split("|")]
                if not re.fullmatch(r"[\s:-]*", "".join(cells)):
                    rows.append(cells)
                i += 1
            width = max(len(r) for r in rows)
            trows = []
            for n, cells in enumerate(rows):
                cells = cells + [""] * (width - len(cells))
                kind = "tableHeader" if n == 0 else "tableCell"
                trows.append({"type": "tableRow", "content": [
                    {"type": kind, "attrs": {},
                     "content": [{"type": "paragraph", "content": _inline_adf(c or " ")}]}
                    for c in cells]})
            content.append({"type": "table",
                            "attrs": {"isNumberColumnEnabled": False,
                                      "layout": "default"},
                            "content": trows})
            continue

        li = re.match(r"^\s*([-*+]|\d+[.)])\s+(.*)$", line)
        if li:
            para(buf); buf = []
            ordered = not li.group(1) in ("-", "*", "+")
            items = []
            while i < len(lines):
                m2 = re.match(r"^\s*([-*+]|\d+[.)])\s+(.*)$", lines[i])
                if not m2:
                    break
                is_ord = m2.group(1) not in ("-", "*", "+")
                if is_ord != ordered:
                    break
                items.append({
                    "type": "listItem",
                    "content": [{"type": "paragraph",
                                 "content": _inline_adf(m2.group(2))}],
                })
                i += 1
            content.append({"type": "orderedList" if ordered else "bulletList",
                            "content": items})
            continue

        if stripped.startswith(">"):
            para(buf); buf = []
            quote = []
            while i < len(lines) and lines[i].strip().startswith(">"):
                quote.append(lines[i].strip().lstrip(">").strip())
                i += 1
            content.append({
                "type": "blockquote",
                "content": [{"type": "paragraph", "content": _inline_adf(" ".join(quote))}],
            })
            continue

        if not stripped:
            para(buf); buf = []
            i += 1
            continue

        buf.append(stripped)
        i += 1

    para(buf)
    if not content:
        content = [{"type": "paragraph", "content": [{"type": "text", "text": " "}]}]
    return {"type": "doc", "version": 1, "content": content}


def adf_to_md(node, depth=0):
    """ADF -> Markdown. Lossy on exotic nodes, faithful on everything we emit."""
    if node is None:
        return ""
    if isinstance(node, str):
        return node
    if isinstance(node, list):
        return "".join(adf_to_md(n, depth) for n in node)

    t = node.get("type")
    kids = node.get("content", []) or []

    if t == "text":
        s = node.get("text", "")
        for mark in node.get("marks", []) or []:
            mt = mark.get("type")
            if mt == "code":
                s = f"`{s}`"
            elif mt == "strong":
                s = f"**{s}**"
            elif mt == "em":
                s = f"*{s}*"
            elif mt == "link":
                s = f"[{s}]({mark.get('attrs', {}).get('href', '')})"
        return s
    if t == "hardBreak":
        return "\n"
    if t == "paragraph":
        return adf_to_md(kids, depth) + "\n\n"
    if t == "heading":
        lvl = node.get("attrs", {}).get("level", 1)
        return "#" * lvl + " " + adf_to_md(kids, depth) + "\n\n"
    if t == "codeBlock":
        lang = node.get("attrs", {}).get("language", "")
        return f"```{lang}\n" + adf_to_md(kids, depth) + "\n```\n\n"
    if t == "rule":
        return "---\n\n"
    if t in ("bulletList", "orderedList"):
        out = []
        for n, item in enumerate(kids, 1):
            bullet = f"{n}. " if t == "orderedList" else "- "
            inner = adf_to_md(item.get("content", []), depth + 1).strip()
            pad = "  " * depth
            first, *rest = inner.split("\n") or [""]
            out.append(pad + bullet + first)
            out.extend(pad + "  " + r for r in rest if r.strip())
        return "\n".join(out) + "\n\n"
    if t == "listItem":
        return adf_to_md(kids, depth)
    if t == "blockquote":
        inner = adf_to_md(kids, depth).strip()
        return "\n".join("> " + l for l in inner.split("\n")) + "\n\n"
    if t in ("table",):
        rows = []
        for row in kids:
            cells = [adf_to_md(c.get("content", []), depth).strip().replace("\n", " ")
                     for c in row.get("content", []) or []]
            rows.append("| " + " | ".join(cells) + " |")
        if rows:
            head = rows[0].count("|") - 1
            rows.insert(1, "|" + "---|" * head)
        return "\n".join(rows) + "\n\n"
    if t in ("mediaSingle", "mediaGroup"):
        out = []
        for m in kids:
            a = m.get("attrs", {}) or {}
            alt = a.get("alt") or "image"
            ref = a.get("url") or f"media:{a.get('id', '')}"
            out.append(f"![{alt}]({ref})")
        return "\n".join(out) + "\n\n"
    if t == "media":
        a = node.get("attrs", {}) or {}
        return f"![{a.get('alt') or 'image'}]({a.get('url') or 'media:' + str(a.get('id',''))})"
    if t == "mention":
        return "@" + node.get("attrs", {}).get("text", "").lstrip("@")
    if t == "emoji":
        return node.get("attrs", {}).get("text", "")
    if t == "doc":
        return adf_to_md(kids, depth)
    return adf_to_md(kids, depth)


IMAGE_PLACEHOLDER = "_atlImage"


def _body_and_dir(text):
    """Body text plus the directory relative paths inside it resolve against.

    `@file.md` reads the file and anchors image paths next to it, which is what
    anyone writing a document with screenshots beside it expects.
    """
    if text.startswith("@"):
        path = os.path.expanduser(text[1:])
        with open(path) as f:
            return f.read(), os.path.dirname(os.path.abspath(path))
    return text, os.getcwd()


def _jira_media_id(creds, attachment_id):
    """The ADF media UUID behind a Jira attachment.

    Jira validates that a media node's id is a real media-services file, and no
    REST field exposes it. The content endpoint 303s to the media API, and the
    UUID is in that Location header.
    """
    url = f"{creds['url']}/rest/api/3/attachment/content/{attachment_id}"

    class _NoRedirect(urllib.request.HTTPRedirectHandler):
        def redirect_request(self, *a, **kw):
            return None

    req = urllib.request.Request(url, headers={"Authorization": _auth_header(creds)})
    try:
        urllib.request.build_opener(_NoRedirect).open(req, timeout=60)
    except urllib.error.HTTPError as e:
        loc = e.headers.get("Location", "") or ""
        m = re.search(r"/file/([0-9a-fA-F-]{36})", loc)
        if m:
            return m.group(1)
    raise ApiError(0, f"could not resolve a media id for attachment {attachment_id}", url)


def _media_node(file_id, collection, alt, width=None, height=None):
    attrs = {"type": "file", "id": file_id, "collection": collection}
    if alt:
        attrs["alt"] = alt
    if width:
        attrs["width"], attrs["height"] = width, height
    return {"type": "mediaSingle", "attrs": {"layout": "center"},
            "content": [{"type": "media", "attrs": attrs}]}


def _upload_for_media(creds, target, path, alt):
    """Attach a local file to the target and return the ADF node that shows it."""
    kind, ident = target
    if kind == "jira":
        res = upload(creds, f"/rest/api/3/issue/{ident}/attachments", path)
        att = res[0] if isinstance(res, list) else res
        # collection must be present but may be empty for issue attachments
        return _media_node(_jira_media_id(creds, att["id"]), "", alt or att["filename"])
    if kind == "confluence":
        res = upload(creds, f"/rest/api/content/{ident}/child/attachment", path,
                     base=creds["confluence_url"])
        a = (res.get("results") or [res])[0]
        ext = a.get("extensions", {}) or {}
        if not ext.get("fileId"):
            raise ApiError(0, f"Confluence returned no fileId for {path}", ident)
        return _media_node(ext["fileId"], ext.get("collectionName", f"contentId-{ident}"),
                           alt or a.get("title", ""))
    raise ValueError(f"unknown media target {kind!r}")


def resolve_media(creds, doc, target, base_dir=None):
    """Replace image placeholders with real media nodes, uploading as needed.

    Local paths are attached to `target` and become inline images. Remote URLs
    become links: Jira accepts an external media node but does not render it,
    and a link that works beats an image that silently does not.
    """
    base_dir = base_dir or os.getcwd()
    uploaded = {}
    missing = []

    def convert(node):
        src = node["attrs"]["src"]
        alt = node["attrs"].get("alt", "")
        if re.match(r"^[a-z][a-z0-9+.-]*://", src, re.I):
            label = alt or src
            return {"type": "paragraph", "content": [
                {"type": "text", "text": label,
                 "marks": [{"type": "link", "attrs": {"href": src}}]}]}
        path = os.path.expanduser(src)
        if not os.path.isabs(path):
            path = os.path.join(base_dir, path)
        path = os.path.abspath(path)
        if not os.path.isfile(path):
            missing.append(src)
            return {"type": "paragraph", "content": [
                {"type": "text", "text": f"[missing image: {src}]"}]}
        if path not in uploaded:
            uploaded[path] = _upload_for_media(creds, target, path, alt)
        node_out = json.loads(json.dumps(uploaded[path]))
        if alt:
            node_out["content"][0]["attrs"]["alt"] = alt
        return node_out

    def walk(container):
        out = []
        for n in container:
            if isinstance(n, dict) and n.get("type") == IMAGE_PLACEHOLDER:
                out.append(convert(n))
                continue
            if isinstance(n, dict) and n.get("content"):
                n["content"] = walk(n["content"])
            out.append(n)
        return out

    doc["content"] = walk(doc.get("content", []))
    if missing:
        print(f"atl: warning — image file(s) not found: {', '.join(missing)}",
              file=sys.stderr)
    return doc


def has_images(doc):
    found = []

    def walk(n):
        if isinstance(n, dict):
            if n.get("type") == IMAGE_PLACEHOLDER:
                found.append(n)
            for c in n.get("content", []) or []:
                walk(c)
        elif isinstance(n, list):
            for c in n:
                walk(c)

    walk(doc)
    return bool(found)


def strip_images(doc):
    """Drop image placeholders so the document is valid ADF before the target
    exists. Used for the first pass of create; the second pass puts them back
    as real media once there is something to attach to."""
    def walk(container):
        out = []
        for n in container:
            if isinstance(n, dict) and n.get("type") == IMAGE_PLACEHOLDER:
                continue
            if isinstance(n, dict) and n.get("content"):
                n["content"] = walk(n["content"])
            out.append(n)
        return out

    doc["content"] = walk(doc.get("content", []))
    if not doc["content"]:
        doc["content"] = [{"type": "paragraph",
                           "content": [{"type": "text", "text": " "}]}]
    return doc


def body_adf(creds, text, target=None):
    """Markdown -> ADF, uploading any local images to `target` along the way."""
    raw, base = _body_and_dir(text)
    doc = md_to_adf(raw)
    if target is not None:
        doc = resolve_media(creds, doc, target, base)
    return doc


def flat(adf):
    """One-line plain text — for list views."""
    return " ".join(adf_to_md(adf).split())


