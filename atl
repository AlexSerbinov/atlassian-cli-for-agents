class _SubParser(argparse.ArgumentParser):
    """Subparser that hands `--json` down to its own sub-subparsers too."""

    common = None

    def add_subparsers(self, **kw):
        kw.setdefault("parser_class", _SubParser)
        group = super().add_subparsers(**kw)
        orig = group.add_parser

        def add_parser(name, **kw2):
            parents = list(kw2.pop("parents", []))
            if _SubParser.common is not None:
                parents.append(_SubParser.common)
            return orig(name, parents=parents, **kw2)

        group.add_parser = add_parser
        return group


def build_parser():
    p = argparse.ArgumentParser(
        prog="atl", description="Token-efficient CLI for Jira + Confluence Cloud")
    p.add_argument("--json", action="store_true",
                   help="raw API JSON instead of the compact view")
    p.add_argument("--version", action="version", version=f"atl {__version__}")

    # `--json` is accepted both before and after the subcommand — argparse only
    # gives you the former unless every subparser inherits the flag too.
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--json", action="store_true", default=None,
                        help=argparse.SUPPRESS)

    sub = p.add_subparsers(dest="cmd", required=True, parser_class=_SubParser)
    _SubParser.common = common

    def add(name, fn, help_=""):
        s = sub.add_parser(name, help=help_, parents=[common])
        s.set_defaults(fn=fn)
        return s

    s = add("init", cmd_init, "write ~/.atl.json interactively")
    s.add_argument("--force", action="store_true", help="overwrite an existing config")
    s.add_argument("--scoped", action="store_true",
                   help="use a scoped API token (routes calls via api.atlassian.com)")

    add("me", cmd_me, "who the token belongs to")

    s = add("issue", cmd_issue, "show one work item")
    s.add_argument("key")
    s.add_argument("--full", action="store_true", help="all fields incl. custom")
    s.add_argument("--fields", help="comma-separated field list")

    s = add("search", cmd_search, "JQL search")
    s.add_argument("jql")
    s.add_argument("--limit", type=int, default=50)
    s.add_argument("--fields", help="comma-separated field list")

    s = add("create", cmd_create, "create a work item")
    s.add_argument("--project", required=True)
    s.add_argument("--type", default="Task")
    s.add_argument("--summary", required=True)
    s.add_argument("--description", help="Markdown, or @file.md")
    s.add_argument("--ac", help="acceptance criteria: Markdown or @file.md")
    s.add_argument("--ac-field", help="override the AC custom field id")
    s.add_argument("--assignee")
    s.add_argument("--parent")
    s.add_argument("--labels", nargs="*")
    s.add_argument("--priority")
    s.add_argument("--sprint", help="sprint id")
    s.add_argument("--sprint-field", help="override the Sprint custom field id")
    s.add_argument("--field", action="append", help="raw field, e.g. customfield_1=10")

    s = add("edit", cmd_edit, "edit a work item")
    s.add_argument("key")
    s.add_argument("--summary")
    s.add_argument("--description")
    s.add_argument("--ac")
    s.add_argument("--ac-field")
    s.add_argument("--assignee")
    s.add_argument("--labels", nargs="*")
    s.add_argument("--priority")
    s.add_argument("--sprint")
    s.add_argument("--sprint-field", help="override the Sprint custom field id")
    s.add_argument("--field", action="append")

    s = add("transitions", cmd_transitions, "list transitions available right now")
    s.add_argument("key")

    s = add("transition", cmd_transition, "move a work item; --comment works too")
    s.add_argument("key")
    s.add_argument("--to", help="target status name (fuzzy)")
    s.add_argument("--id", help="transition id")
    s.add_argument("--comment", help="posted as a separate call, Markdown or @file.md")

    s = add("comment", cmd_comment, "add a comment (Markdown -> ADF)")
    s.add_argument("key")
    s.add_argument("text")

    s = add("comments", cmd_comments, "read comments")
    s.add_argument("key")
    s.add_argument("--limit", type=int, default=20)

    s = add("comment-edit", cmd_comment_edit, "rewrite an existing comment")
    s.add_argument("key"); s.add_argument("id"); s.add_argument("text")

    s = add("comment-rm", cmd_comment_rm, "delete a comment")
    s.add_argument("key"); s.add_argument("id")

