def _issue_line(i):
    f = i.get("fields", {})
    st = (f.get("status") or {}).get("name", "?")
    who = (f.get("assignee") or {}).get("displayName", "—")
    typ = (f.get("issuetype") or {}).get("name", "?")
    return f"{i['key']:<10} {st:<14} {typ:<8} {who:<20} {f.get('summary', '')}"


def cmd_issue(creds, a):
    fields = a.fields or ("*all" if a.full else BRIEF_FIELDS + ",description,reporter,labels,components,fixVersions,created,updated,resolution")
    i = api(creds, f"/rest/api/3/issue/{a.key}", {"fields": fields})
    if a.json:
        return out_json(i)
    f = i["fields"]
    print(f"{i['key']}  {f.get('summary', '')}")
    def nm(field, attr="name"):
        return (f.get(field) or {}).get(attr) or "—"

    print(f"  status:   {nm('status')}   type: {nm('issuetype')}   prio: {nm('priority')}")
    print(f"  assignee: {nm('assignee', 'displayName')}"
          f"   reporter: {nm('reporter', 'displayName')}")
    if f.get("parent"):
        print(f"  parent:   {f['parent']['key']}  {f['parent']['fields']['summary']}")
    if f.get("labels"):
        print(f"  labels:   {', '.join(f['labels'])}")
    tt = f.get("timetracking") or {}
    if tt:
        print(f"  time:     spent {tt.get('timeSpent', '0')}"
              f"  est {tt.get('originalEstimate', '—')}")
    print(f"  url:      {creds['site']}/browse/{i['key']}")
    desc = adf_to_md(f.get("description")).strip()
    if desc:
        print("\n--- description ---")
        print(desc)
    for name, val in sorted(f.items()):
        if not name.startswith("customfield_") or val is None:
            continue
        if a.full:
            rendered = adf_to_md(val).strip() if isinstance(val, dict) and val.get("type") == "doc" else str(val)
            if rendered and rendered != "None":
                print(f"\n--- {name} ---\n{rendered[:2000]}")


def cmd_search(creds, a):
    fields = a.fields or BRIEF_FIELDS
    rows, token, seen = [], None, 0
    while True:
        params = {"jql": a.jql, "fields": fields, "maxResults": min(100, a.limit - seen)}
        if token:
            params["nextPageToken"] = token
        data = api(creds, "/rest/api/3/search/jql", params)
        batch = data.get("issues", [])
        rows.extend(batch)
        seen += len(batch)
        token = data.get("nextPageToken")
        if not token or data.get("isLast") or seen >= a.limit or not batch:
            break
    if a.json:
        return out_json(rows)
    for i in rows:
        print(_issue_line(i))
    print(f"\n{len(rows)} issue(s)")


