def _from_claude_json():
    """Legacy source: the mcp-atlassian server args in ~/.claude.json."""
    try:
        with open(CLAUDE_CONFIG) as f:
            cfg = json.load(f)
    except (OSError, ValueError):
        return {}
    args = cfg.get("mcpServers", {}).get("atlassian", {}).get("args", [])
    out = {}
    keys = {
        "--jira-url=": "url",
        "--jira-username=": "user",
        "--jira-token=": "token",
        "--confluence-url=": "confluence_url",
    }
    for a in args:
        for prefix, name in keys.items():
            if a.startswith(prefix):
                out[name] = a[len(prefix):]
    return out


def load_creds():
    out = {}
    if os.path.exists(ATL_CONFIG):
        try:
            with open(ATL_CONFIG) as f:
                out.update(json.load(f))
        except ValueError as e:
            sys.exit(f"atl: {ATL_CONFIG} is not valid JSON: {e}")

    out.setdefault("url", os.environ.get("ATL_URL", ""))
    out.setdefault("user", os.environ.get("ATL_USER", ""))

    if os.path.exists(ATL_CONFIG):
        _warn_if_world_readable(ATL_CONFIG)

    if not out.get("token"):
        out["token"] = os.environ.get("ATL_TOKEN", "")

    if not out.get("token") and out.get("token_command"):
        out["token"] = _read_token_command(out["token_command"])

    if not out.get("token") and os.path.exists(TOKEN_FILE):
        with open(TOKEN_FILE) as f:
            out["token"] = f.read().strip()

    if not all(out.get(k) for k in ("url", "user", "token")):
        for k, v in _from_claude_json().items():
            if not out.get(k):
                out[k] = v

    missing = [k for k in ("url", "user", "token") if not out.get(k)]
    if missing:
        sys.exit(
            f"atl: missing credentials: {', '.join(missing)}.\n"
            f"Create {ATL_CONFIG} with "
            '{"url": "https://you.atlassian.net", "user": "you@x.com", "token": "..."}'
        )

    out["url"] = out["url"].rstrip("/")
    if not out.get("confluence_url"):
        out["confluence_url"] = out["url"] + "/wiki"
    out["confluence_url"] = out["confluence_url"].rstrip("/")

    # `site` is where humans go (browse links). `url` is where the API calls go,
    # which differs once a cloud id sends us through the api.atlassian.com
    # gateway — the only endpoint scoped API tokens are allowed to use.
    out["site"] = out["url"]
    out["site_wiki"] = out["confluence_url"]
    if out.get("cloud_id"):
        gw = "https://api.atlassian.com/ex"
        out["url"] = f"{gw}/jira/{out['cloud_id']}"
        out["confluence_url"] = f"{gw}/confluence/{out['cloud_id']}/wiki"
    return out


def _read_token_command(cmd):
    """Run a user-supplied command and take its stdout as the token.

    This is the hook for password managers: 1Password, pass, gopass, Vault, or
    the OS keychain. The token travels on a pipe, never on a command line, and
    atl never sees where it is stored.
    """
    import subprocess

    try:
        res = subprocess.run(cmd, shell=True, capture_output=True, timeout=60)
    except (OSError, subprocess.SubprocessError) as e:
        sys.exit(f"atl: token_command failed to run: {e}")
    if res.returncode != 0:
        err = res.stderr.decode("utf-8", "replace").strip()[:300]
        sys.exit(f"atl: token_command exited {res.returncode}: {err}")
    token = res.stdout.decode("utf-8", "replace").strip()
    if not token:
        sys.exit("atl: token_command produced no output")
    return token


def _warn_if_world_readable(path):
    try:
        mode = os.stat(path).st_mode
    except OSError:
        return
    if mode & 0o077:
        print(f"atl: warning — {path} is readable by other users "
              f"(mode {oct(mode & 0o777)}). Run: chmod 600 {path}", file=sys.stderr)


def discover_cloud_id(site_url):
    """The site's cloud id, needed for scoped tokens. Public, no auth."""
    url = site_url.rstrip("/") + "/_edge/tenant_info"
    try:
        with urllib.request.urlopen(url, timeout=30) as r:
            return json.load(r).get("cloudId")
    except Exception:
        return None


def resolve_sprint_field(creds):
    """Find the Sprint custom field id for this site, and remember it."""
    if creds.get("sprint_field"):
        return creds["sprint_field"]
    try:
        for f in api(creds, "/rest/api/3/field"):
            if f.get("name") == "Sprint" and f.get("custom"):
                fid = f["id"]
                _remember(creds, "sprint_field", fid)
                return fid
    except ApiError:
        pass
    return SPRINT_FIELD_DEFAULT


def _remember(creds, key, value):
    """Cache a resolved site constant back into ~/.atl.json. Best effort."""
    creds[key] = value
    try:
        cfg = {}
        if os.path.exists(ATL_CONFIG):
            with open(ATL_CONFIG) as f:
                cfg = json.load(f)
        cfg[key] = value
        tmp = ATL_CONFIG + ".tmp"
        with open(tmp, "w") as f:
            json.dump(cfg, f, indent=2)
        os.chmod(tmp, 0o600)
        os.replace(tmp, ATL_CONFIG)
    except (OSError, ValueError):
        pass


