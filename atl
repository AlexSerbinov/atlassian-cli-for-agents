def _find_ac_field(creds, project, issuetype):
    """Acceptance Criteria is a custom field whose id differs per site."""
    meta = api(creds, "/rest/api/3/issue/createmeta",
               {"projectKeys": project, "expand": "projects.issuetypes.fields"})
    for p in meta.get("projects", []):
        for it in p.get("issuetypes", []):
            if issuetype and it["name"].lower() != issuetype.lower():
                continue
            for fid, spec in it.get("fields", {}).items():
                if "acceptance" in spec.get("name", "").lower():
                    return fid
    return None


def cmd_create(creds, a):
    ac_field_id = None
    fields = {
        "project": {"key": a.project},
        "summary": a.summary,
        "issuetype": {"name": a.type},
    }
    if a.description:
        # Placeholders are not valid ADF, and there is nothing to attach to
        # until the issue has a key. Strip them now, wire them in below.
        fields["description"] = strip_images(md_to_adf(_body_and_dir(a.description)[0]))
    if a.ac:
        fid = a.ac_field or _find_ac_field(creds, a.project, a.type)
        if not fid:
            sys.exit("atl: no Acceptance Criteria field on this project; pass --ac-field")
        fields[fid] = strip_images(md_to_adf(_body_and_dir(a.ac)[0]))
        ac_field_id = fid
    if a.assignee:
        fields["assignee"] = {"id": resolve_account(creds, a.assignee)}
    if a.parent:
        fields["parent"] = {"key": a.parent}
    if a.labels:
        fields["labels"] = a.labels
    if a.priority:
        fields["priority"] = {"name": a.priority}
    if a.sprint:
        fields[a.sprint_field or resolve_sprint_field(creds)] = int(a.sprint)
    for kv in a.field or []:
        k, _, v = kv.partition("=")
        fields[k] = _coerce(v)

    res = api(creds, "/rest/api/3/issue", method="POST", body={"fields": fields})

    # Second pass: images can only be attached once the issue has a key.
    late = {}
    if a.description and has_images(md_to_adf(_body_and_dir(a.description)[0])):
        late["description"] = body_adf(creds, a.description, ("jira", res["key"]))
    if a.ac and ac_field_id and has_images(md_to_adf(_body_and_dir(a.ac)[0])):
        late[ac_field_id] = body_adf(creds, a.ac, ("jira", res["key"]))
    if late:
        api(creds, f"/rest/api/3/issue/{res['key']}", method="PUT",
            body={"fields": late})

    if a.json:
        return out_json(res)
    print(f"{res['key']}  {creds['site']}/browse/{res['key']}")


def _coerce(v):
    """--field customfield_1=10 -> int; ={"a":1} -> dict; else str."""
    v = v.strip()
    if v.startswith(("{", "[")):
        return json.loads(v)
    if re.fullmatch(r"-?\d+", v):
        return int(v)
    return v


def _maybe_file(s):
    """'@path.md' reads the file — keeps long bodies off the command line."""
    if s.startswith("@"):
        with open(os.path.expanduser(s[1:])) as f:
            return f.read()
    return s


def cmd_edit(creds, a):
    fields = {}
    if a.summary:
        fields["summary"] = a.summary
    if a.description:
        fields["description"] = body_adf(creds, a.description, ("jira", a.key))
    if a.ac:
        fid = a.ac_field
        if not fid:
            i = api(creds, f"/rest/api/3/issue/{a.key}", {"fields": "project,issuetype"})
            fid = _find_ac_field(creds, i["fields"]["project"]["key"],
                                 i["fields"]["issuetype"]["name"])
        if not fid:
            sys.exit("atl: no Acceptance Criteria field found; pass --ac-field")
        fields[fid] = body_adf(creds, a.ac, ("jira", a.key))
    if a.assignee:
        fields["assignee"] = {"id": resolve_account(creds, a.assignee)}
    if a.labels:
        fields["labels"] = a.labels
    if a.priority:
        fields["priority"] = {"name": a.priority}
    if a.sprint:
        fields[a.sprint_field or resolve_sprint_field(creds)] = int(a.sprint)
    for kv in a.field or []:
        k, _, v = kv.partition("=")
        fields[k] = _coerce(v)
    if not fields:
        sys.exit("atl: nothing to edit")
    api(creds, f"/rest/api/3/issue/{a.key}", method="PUT", body={"fields": fields})
    print(f"{a.key} updated: {', '.join(fields)}")


def cmd_transition(creds, a):
    data = api(creds, f"/rest/api/3/issue/{a.key}/transitions")
    trans = data.get("transitions", [])
    pick = None
    if a.id:
        pick = next((t for t in trans if t["id"] == str(a.id)), None)
    else:
        want = a.to.lower()
        pick = next((t for t in trans if t["to"]["name"].lower() == want), None) \
            or next((t for t in trans if t["name"].lower() == want), None) \
            or next((t for t in trans if want in t["to"]["name"].lower()), None)
    if not pick:
        avail = ", ".join(f"{t['name']}->{t['to']['name']}" for t in trans)
        sys.exit(f"atl: no transition to {a.to or a.id!r} from here. Available: {avail}")

    api(creds, f"/rest/api/3/issue/{a.key}/transitions", method="POST",
        body={"transition": {"id": pick["id"]}})
    print(f"{a.key} -> {pick['to']['name']}  (via '{pick['name']}', id {pick['id']})")

    # mcp-atlassian could not do this in one step; here it is just a second call.
    if a.comment:
        api(creds, f"/rest/api/3/issue/{a.key}/comment", method="POST",
            body={"body": body_adf(creds, a.comment, ("jira", a.key))})
        print(f"{a.key} comment added")


